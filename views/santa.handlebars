<div id="santaContainer">
	<form id="frmAssign" action="/process" method="POST">
		{{#each santas}}
		<div id="santa{{id}}" class="santa">
			<label for="txtName{{id}}">
				<span class="labelText">NAME</span>
				<input id="txtName{{id}}" name="txtName{{id}}" type="text" placeholder="John"  />
			</label>

			<label for="txtEmail{{id}}">
				<span class="labelText">EMAIL</span>
				<input id="txtEmail{{id}}" name="txtName{{id}}" type="email" placeholder="john12345@gmail.com"  />
			</label>
			<input type="text" id="hidAssigned{{id}}" name="hidAssigned{{id}}" value="{{value}}" />
		</div>
		{{/each}}

		<input type="text" id="hidSantas" name="hidSantas" value="{{santas.length}}" />
	</form>

	<hr />

	<button onclick="gotoStart()">Back</button>
	<button onclick="gotoAssign()">Assign</button>	
</div>

