<!DOCTYPE html>
<html>
	<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<title>Xmas Mailer</title>

		<style>
			body {
				font-family: verdana, sans-serif;
				font-size: 14px;
				background-color: rgba(0, 200, 0, 0.5);
			}

			h1 {
				text-align: center;
			}

			#santaContainer {
				width: 700px;
				padding: 1em;
				display: block;
				margin: 0 auto 0 auto;
				text-align: center;
			}

			label {
				display: inline-block;
				margin-top: 1em;
				margin-left: 3em;
				font-weight: bold;
			}

			.labelText {
				display: inline-block;
				width: 5em;
				margin-right: 1em;
				float: left;
			}

			input {
				border-radius: 5px;
				width: 15em;
				height: 1.5em;
				border: 2px solid rgb(100, 100, 100);
			}

			button {
				border-radius: 5px;
				border: none;
				display: inline-block;
				width: 8em;
				height: 2em;
				background-color: rgb(200, 0, 0);
				color: rgb(255, 255, 255);
			}

			button:hover {
				font-weight: bold;
			}

			.error {
				border: 2px solid rgb(255, 0, 0);
			}
		</style>

		<script>
			function gotoStart() {
				window.location = "/";
			}

			function gotoSantas() {
				var txtSantas = document.getElementById("txtSantas").value;	

				window.location = "/santa/" + txtSantas;
			}

			function gotoAssign() {
				//validate
				var hidSantas = document.getElementById("hidSantas").value;

				for (let i = 0; i < hidSantas; i++) {
					var txtName = document.getElementById("txtName" + i);
					if (txtName.value.trim().length === 0) {
						txtName.className = "error";
					} else {
						txtName.className = "";
					}

					var txtEmail = document.getElementById("txtEmail" + i);
					var emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
					if (txtEmail.value.trim().length === 0 || !emailRegex.test(txtEmail.value)) {
						txtEmail.className = "error";
					} else {
						txtEmail.className = "";
					}
				}

				//submit form
				if (document.getElementByClassName("error").length === 0) {

				}
			}
		</script>
	</head>
	<body>
		{{{ body }}}
	</body>
</html>